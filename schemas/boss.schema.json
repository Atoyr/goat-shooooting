{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boss Definition v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "enemyId", "phases"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "enemyId": { "type": "string", "minLength": 1 },
    "warningSeconds": { "type": "number", "minimum": 0, "default": 5 },
    "bgmAudioId": { "type": ["string", "null"], "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hp", "timeLimit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "hp": { "type": "integer", "minimum": 1 },
          "timeLimit": { "type": "number", "exclusiveMinimum": 0 },
          "motionPatternId": { "type": ["string", "null"] },
          "attackPatternIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "invulnerabilitySeconds": { "type": "number", "minimum": 0, "default": 0 },
          "checkpointId": { "type": ["string", "null"], "minLength": 1 },
          "startProjectileCancel": { "enum": ["none", "soft", "all"], "default": "none" },
          "endProjectileCancel": { "enum": ["none", "soft", "all"], "default": "soft" },
          "baseBonus": { "type": "integer", "minimum": 0, "default": 0 },
          "timeBonusPerSecond": { "type": "integer", "minimum": 0, "default": 0 },
          "noMissBonus": { "type": "integer", "minimum": 0, "default": 0 },
          "noBombBonus": { "type": "integer", "minimum": 0, "default": 0 },
          "dropTable": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId"],
              "properties": {
                "itemId": { "type": "string", "minLength": 1 },
                "count": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
                "chance": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
                "scatterSpeed": { "type": "number", "minimum": 0, "default": 80 }
              }
            },
            "default": []
          }
        }
      }
    }
  }
}

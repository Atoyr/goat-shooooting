{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boss Definition v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "enemyId", "phases"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "enemyId": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hp", "timeLimit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "hp": { "type": "integer", "minimum": 1 },
          "timeLimit": { "type": "number", "exclusiveMinimum": 0 },
          "motionPatternId": { "type": ["string", "null"] },
          "attackPatternIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Definition",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["playerId", "stageId"] },
    { "required": ["schemaVersion", "id", "defaultRuleSetId", "ruleSetIds", "difficultyIds", "shipIds", "stageRouteId"] }
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2], "default": 1 },
    "id": { "type": "string", "minLength": 1 },
    "playerId": { "type": "string", "minLength": 1, "description": "Player definition id." },
    "stageId": { "type": "string", "minLength": 1, "description": "Initial stage definition id." },
    "width": { "type": "integer", "minimum": 1, "description": "Playfield width in pixels." },
    "height": { "type": "integer", "minimum": 1, "default": 720, "description": "Playfield height in pixels." },
    "defaultRuleSetId": { "type": "string", "minLength": 1 },
    "ruleSetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "difficultyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "shipIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stageRouteId": { "type": "string", "minLength": 1 },
    "screenLayout": {
      "type": "string",
      "enum": ["full", "touhou", "donpachi"],
      "default": "full",
      "description": "fullは全画面、touhouはプレイ領域＋右パネル、donpachiは左パネル＋プレイ領域＋右パネルです。"
    },
    "hudPanelWidth": {
      "type": "integer",
      "minimum": 120,
      "maximum": 600,
      "default": 200,
      "description": "左右HUDパネルの幅です。widthは常にプレイ領域の幅として維持されます。"
    },
    "scorePosition": {
      "type": "string",
      "enum": ["playfield-top-left", "playfield-top-right", "left-panel", "right-panel"],
      "default": "playfield-top-right",
      "description": "スコアを表示する領域を選びます。left-panelはdonpachi、right-panelはtouhouまたはdonpachiで使用できます。"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "textures", "sprites", "animations", "backgrounds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sprites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "textureId", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "textureId": { "type": "string", "minLength": 1 },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "originX": { "type": ["number", "null"] },
          "originY": { "type": ["number", "null"] },
          "flipX": { "type": "boolean", "default": false },
          "flipY": { "type": "boolean", "default": false },
          "layer": { "type": "integer", "default": 20 }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "frames", "frameDurationSeconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "frames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "frameDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "loop": { "type": "boolean", "default": true }
        }
      }
    },
    "backgrounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assetId"],
              "properties": {
                "assetId": { "type": "string", "minLength": 1 },
                "scrollX": { "type": "number", "default": 0 },
                "scrollY": { "type": "number", "default": 0 },
                "parallax": { "type": "number", "minimum": 0, "default": 1 },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
                "layer": { "type": "integer", "default": 0 }
              }
            }
          }
        }
      }
    }
  }
}

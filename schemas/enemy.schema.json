{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enemy Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "hp", "speed", "radius"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2], "default": 1 },
    "id": { "type": "string", "minLength": 1 },
    "hp": { "type": "integer", "minimum": 1 },
    "speed": { "type": "number", "minimum": 0 },
    "weaponId": { "type": ["string", "null"] },
    "radius": { "type": "number", "exclusiveMinimum": 0 },
    "score": { "type": "integer", "minimum": 1, "default": 100 },
    "movementPattern": { "type": "string", "enum": ["straight", "sine", "zigzag"], "default": "straight" },
    "movementAmplitude": { "type": "number", "minimum": 0, "default": 0 },
    "movementFrequency": { "type": "number", "minimum": 0, "default": 0 },
    "motion": { "$ref": "capability.schema.json" }
  }
}

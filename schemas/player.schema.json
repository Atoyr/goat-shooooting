{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Player Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "speed", "weaponId", "x", "y", "radius"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2], "default": 1 },
    "id": { "type": "string", "minLength": 1 },
    "lives": { "type": "integer", "minimum": 1, "default": 2 },
    "bombs": { "type": "integer", "minimum": 0, "default": 2 },
    "bombDamage": { "type": "integer", "minimum": 1, "default": 50 },
    "speed": { "type": "number", "exclusiveMinimum": 0 },
    "weaponId": { "type": "string", "minLength": 1 },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "radius": { "type": "number", "exclusiveMinimum": 0 },
    "invincibilitySeconds": { "type": "number", "minimum": 0, "default": 1 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pattern Definition v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "commands"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["motion", "attack"] },
    "commands": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object", "default": {} },
          "patternId": { "type": ["string", "null"] },
          "repeatCount": { "type": "integer", "minimum": 1, "maximum": 64, "default": 1 },
          "maximumSpawnCount": { "type": "integer", "minimum": 0, "maximum": 100000, "default": 0 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bullet Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "speed", "damage", "radius", "lifetime"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "speed": { "type": "number", "exclusiveMinimum": 0 },
    "damage": { "type": "integer", "minimum": 1 },
    "radius": { "type": "number", "exclusiveMinimum": 0 },
    "lifetime": { "type": "number", "exclusiveMinimum": 0 },
    "movementPattern": {
      "type": "string",
      "enum": ["straight", "homing"],
      "default": "straight",
      "description": "straightは直進、homingは最も近い対象を追尾します。"
    },
    "homingTurnDegreesPerSecond": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1440,
      "default": 180,
      "description": "homing時に1秒間で曲がれる最大角度です。"
    }
  }
}

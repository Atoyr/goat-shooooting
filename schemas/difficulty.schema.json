{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Difficulty Definition v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "projectileSpeedMultiplier": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
    "fireIntervalMultiplier": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
    "enemyHpMultiplier": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
    "additionalProjectileCount": { "type": "integer", "minimum": 0, "default": 0 },
    "autoBomb": { "type": "boolean", "default": false }
  }
}
